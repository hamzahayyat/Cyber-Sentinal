# VirusTotal — https://www.virustotal.com (free, 500 req/day)
VT_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com (free, 1000 req/day)
ABUSEIPDB_API_KEY=

# Shodan — https://account.shodan.io (free, ~100 scan credits)
SHODAN_API_KEY=

# AlienVault OTX — https://otx.alienvault.com (free, generous limits)
OTX_API_KEY=

# Whois JSON API — https://whoisjsonapi.com (free, 500 req/month)
WHOIS_API_KEY=

# NVD NIST (no key required for basic use)
NVD_API_KEY=

